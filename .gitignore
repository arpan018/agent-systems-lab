# =============================================================================
# OpenAI API Learning Ladder — monorepo gitignore
# Covers Python/uv, FastAPI, tests, RAG stores, Telegram, evals, secrets.
# Add a project-specific ignore only if a later stage creates a new artifact type.
# =============================================================================

# --- Local planning (not published) ------------------------------------------
Temp/
Docs/
docs/_private/

# --- Secrets and local env ---------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p12
*.key
secrets.json
credentials.json
service-account*.json
**/secrets/

# --- Python bytecode and packaging -------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
share/python-wheels/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
ENV/
env/
# Keep uv.lock and .python-version committed once they exist.

# --- Test / lint / type / coverage caches ------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.cache/

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# --- Runtime data (keep empty dirs via .gitkeep if needed) -------------------
data/usage/*.jsonl
data/usage/*.json
!data/usage/.gitkeep
evals/results/**
!evals/results/.gitkeep
logs/
*.log
*.sqlite
*.sqlite3
*.db

# --- RAG / embeddings / vector stores ----------------------------------------
.chroma/
chroma/
chroma_db/
*.faiss
*.index
qdrant_storage/
lance/
lancedb/
**/vectorstore/
**/vector_store/
**/embeddings_cache/
**/.cache/huggingface/
**/.cache/torch/

# --- Telegram / bot sessions -------------------------------------------------
*.session
*.session-journal

# --- OS / editors ------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*~
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Cursor local (keep rules committed) -------------------------------------
.cursor/mcp.json
.cursor/*.log
.cursor/debug.log

# --- Misc tool caches --------------------------------------------------------
.uv/
.npm/
node_modules/
.turbo/
.parcel-cache/
.direnv/
.python-history
